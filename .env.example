# ═══════════════════════════════════════════════════════════════════════
# STEALTHMARK — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE (.env.example)
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Local PostgreSQL + pgvector (via Docker Compose)
DATABASE_URL=postgresql://stealthmark:dev_password@localhost:5432/stealthmark

# Local Web App CORS
CORS_ORIGINS=http://localhost:3000

# Mock / Dev controls
SKIP_DNS_VERIFICATION=false

# Optional: Set persistent Ed25519 keys (otherwise ephemeral dev keys will be auto-generated in memory)
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# ── Feature flags (API). Only the exact string "true" enables a flag; default false ──
# FEATURE_COMMERCE gates: capabilities, discovery, tasks, publisher, evaluations, reviews, badges,
#   negotiations, contracts, escrow, balances, finops, private-registries, a2a, web
# FEATURE_PASSPORTS gates: agent-context, policies, kill-switch, audit, internal/trust
# FEATURE_OBSERVABILITY: reserved for observability modules
FEATURE_COMMERCE=false
FEATURE_PASSPORTS=false
FEATURE_OBSERVABILITY=false

# ── Quota alert emails (API). Without RESEND_API_KEY the API logs and skips the alert; ingest is never affected ──
# RESEND_API_KEY=
# QUOTA_ALERT_FROM=StealthMark <alerts@stealthmark.io>

# ── Feature flags (Web). Only the exact string "true" enables a flag; default false ──
NEXT_PUBLIC_FEATURE_HITL=false
NEXT_PUBLIC_FEATURE_DEFCON=false
NEXT_PUBLIC_FEATURE_SENTINEL=false
NEXT_PUBLIC_FEATURE_DUAL_DOOR_DEMO=false
NEXT_PUBLIC_FEATURE_MCP_PANEL=false

# Authentication Internal Secret (Fastify <-> Next.js Web delegation)
INTERNAL_AUTH_SECRET=dev_internal_auth_secret_key_12345
AUTH_SECRET=dev_stealthmark_session_secret_key_32bytes_min

# ── Supabase Authentication & Database Integration ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Secret Manager in production
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

