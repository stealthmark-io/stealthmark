# Discord Webhook for lead notifications (Server-side only - Keep private!)
# Generate this in your Discord Server -> Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
# Lead intake (waitlist, enterprise contact) answers an error unless Discord or Resend accepts the message
RESEND_API_KEY=

# Optional: Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ── StealthMark Authentication Engine ──────────────────────────────────────────
# Secret key used to sign session cookies with HMAC-SHA256 (min 32 chars)
AUTH_SECRET=dev_stealthmark_session_secret_key_32bytes_min

# Shared secret to authenticate internal requests from Web to Fastify backend (Opción A)
INTERNAL_AUTH_SECRET=dev_internal_auth_secret_key_12345

# Shared secret the web sends to the Python gateway's paid endpoints; must equal the gateway's INTERNAL_AUTH_SECRET (min 32 chars)
GATEWAY_INTERNAL_SECRET=

# Derives the Canary keys for the @stealthmark/next dotfile fixture (min 32 chars). Rotating it revokes every Canary key
CANARY_MASTER_SECRET=

# URL of the internal Fastify API for user/org upserting
INTERNAL_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=https://gateway.stealthmark.io

# GitHub OAuth Credentials (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Credentials (https://console.cloud.google.com/apis/credentials)
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase Authentication & Database Integration ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://wnaovainovzaspjzcgox.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side only (Secret Manager)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Feature flags (inlined at build time; only the exact string "true" enables a flag; default off)
NEXT_PUBLIC_FEATURE_HITL=false
NEXT_PUBLIC_FEATURE_DEFCON=false
NEXT_PUBLIC_FEATURE_SENTINEL=false
NEXT_PUBLIC_FEATURE_DUAL_DOOR_DEMO=false
NEXT_PUBLIC_FEATURE_MCP_PANEL=false
