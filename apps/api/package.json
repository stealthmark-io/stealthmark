{
  "name": "@stealthmark/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fastify": "^5.12.6",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.3",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.7",
    "zod": "^4.6.6",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "@stealthmark/db": "*",
    "@stealthmark/shared": "*"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0",
    "@types/node": "^22.15.0"
  }
