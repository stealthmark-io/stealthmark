# ═══════════════════════════════════════════════════════════════════════
# STEALTHMARK — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ═══════════════════════════════════════════════════════════════════════

# Core Runtime Configuration
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Database Connection (PostgreSQL 16 + pgvector)
# Use Cloud SQL IAM authentication or strong password in production
DATABASE_URL=postgresql://stealthmark_prod:<SECURE_PASSWORD>@<CLOUD_SQL_IP>:5432/stealthmark_prod?sslmode=require

# Web / CORS Origins
CORS_ORIGINS=https://app.stealthmark.io,https://os.stealthmark.io

# Google Cloud Platform Production Project
GCP_PROJECT_ID=stealthmark-prod
GCP_PROJECT_NUMBER=29923645081

# Public Endpoints
NEXT_PUBLIC_GATEWAY_URL=https://gateway.stealthmark.io
NEXT_PUBLIC_API_URL=https://api.stealthmark.io

# Web Vision & Extraction Proxy (optional). Leave unset to have /v1/web/vision and /v1/web/extract
# fail with 502 and no charge when Scrapling is unavailable. Never point it at this API's own host.
# WEB_VISION_UPSTREAM_URL=https://vision-upstream.internal.stealthmark.io
# WEB_VISION_API_KEY=<UPSTREAM_PROD_KEY>

# Security Controls
# NOTE: SKIP_DNS_VERIFICATION is strictly forbidden in production (enforced via Zod schema)
SKIP_DNS_VERIFICATION=false

# ═══════════════════════════════════════════════════════════════════════
# CRYPTOGRAPHIC PASSPORT KEYS (Ed25519)
# Generate with: openssl genpkey -algorithm ed25519 -out passport_private.pem
# Extract public: openssl pkey -in passport_private.pem -pubout -out passport_public.pem
# Format: PEM multiline string escaped as \n, or base64 encoded
# ═══════════════════════════════════════════════════════════════════════
PASSPORT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIK...\n-----END PRIVATE KEY-----"
PASSPORT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAN...\n-----END PUBLIC KEY-----"

# Internal bootstrap secret shared with the control plane. Mounted from Secret Manager
# (INTERNAL_AUTH_SECRET). The API refuses to start in production if it is unset, equals the
# development default, or is shorter than 32 characters. Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=<SECRET_MANAGER_REFERENCE_MIN_32_CHARS>

# ── Feature flags (API). Only the exact string "true" enables a flag; default false ──
# FEATURE_COMMERCE gates: capabilities, discovery, tasks, publisher, evaluations, reviews, badges,
#   negotiations, contracts, escrow, balances, finops, private-registries, a2a, web
# FEATURE_PASSPORTS gates: agent-context, policies, kill-switch, audit, internal/trust
# FEATURE_OBSERVABILITY: reserved for observability modules
FEATURE_COMMERCE=false
FEATURE_PASSPORTS=false
FEATURE_OBSERVABILITY=false

# ── Feature flags (Web). Only the exact string "true" enables a flag; default false ──
NEXT_PUBLIC_FEATURE_HITL=false
NEXT_PUBLIC_FEATURE_DEFCON=false
NEXT_PUBLIC_FEATURE_SENTINEL=false
NEXT_PUBLIC_FEATURE_DUAL_DOOR_DEMO=false
NEXT_PUBLIC_FEATURE_MCP_PANEL=false

# Distributed In-Memory Cache (Redis)
# Required for multi-instance rolling counters and rate limiting
REDIS_URL=rediss://default:<REDIS_PASSWORD>@<REDIS_HOST>:6379
